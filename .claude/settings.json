{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["./data.noindex"]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    }
  },
  "permissions": {
    "deny": [
      "Read(/data.noindex/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)"
    ]
  }
}
